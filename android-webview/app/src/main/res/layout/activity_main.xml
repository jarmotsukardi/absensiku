<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/webRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:enabled="false"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/webViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/webConnectionStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#EAF3FF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#BFD5F6"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:id="@+id/webConnectionStatusTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/web_connection_status_title"
                        android:textColor="#24416D"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/webConnectionStatusMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/web_connection_status_message"
                        android:textColor="#52637D"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/webConnectionRetryButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:minHeight="40dp"
                        android:text="@string/web_connection_retry"
                        android:textAllCaps="false"
                        app:cornerRadius="14dp"
                        app:strokeColor="#B6CCEF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/loginPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    app:cardBackgroundColor="#F7F9FC"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#DDE5F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="24dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="18dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/tenantLogoCard"
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:layout_marginBottom="14dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="#F4F7FB"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#E0E8F2"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:id="@+id/tenantLogoImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Logo Organisasi"
                                android:padding="14dp"
                                android:scaleType="fitCenter" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tenantNameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textColor="#334155"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/login_title"
                            android:textColor="#64748B"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/login_subtitle"
                            android:textColor="#74839A"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/login_status_ready"
                            android:textColor="#7D8BA0"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/loginErrorText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="#FDECEC"
                            android:gravity="center_vertical"
                            android:padding="12dp"
                            android:textColor="#9F1D1D"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/authTabs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@android:color/transparent"
                            app:tabGravity="fill"
                            app:tabIndicatorAnimationMode="elastic"
                            app:tabIndicatorColor="#245EE5"
                            app:tabIndicatorFullWidth="false"
                            app:tabMode="fixed"
                            app:tabRippleColor="#1A245EE5"
                            app:tabSelectedTextColor="#245EE5"
                            app:tabTextColor="#7D8BA0">

                            <com.google.android.material.tabs.TabItem
                                android:text="@string/login_tab" />

                            <com.google.android.material.tabs.TabItem
                                android:text="@string/register_tab" />
                        </com.google.android.material.tabs.TabLayout>

                        <LinearLayout
                            android:id="@+id/loginFormContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="@string/login_email_label"
                                android:textColor="#44546B"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/emailLayout"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="@string/login_email_hint"
                                app:boxBackgroundColor="#FEFEFF"
                                app:boxCornerRadiusBottomEnd="18dp"
                                app:boxCornerRadiusBottomStart="18dp"
                                app:boxCornerRadiusTopEnd="18dp"
                                app:boxCornerRadiusTopStart="18dp"
                                app:boxStrokeColor="#D6DEEA"
                                app:startIconDrawable="@android:drawable/ic_dialog_email"
                                app:startIconTint="#98A6BA">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/emailEdit"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:autofillHints="username"
                                    android:importantForAutofill="yes"
                                    android:inputType="textEmailAddress"
                                    android:maxLines="1"
                                    android:textColor="#344158"
                                    android:textColorHint="#97A4B7" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/login_password_label"
                                    android:textColor="#44546B"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/passwordLayout"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="@string/login_password_hint"
                                app:boxBackgroundColor="#FEFEFF"
                                app:boxCornerRadiusBottomEnd="18dp"
                                app:boxCornerRadiusBottomStart="18dp"
                                app:boxCornerRadiusTopEnd="18dp"
                                app:boxCornerRadiusTopStart="18dp"
                                app:boxStrokeColor="#D6DEEA"
                                app:endIconMode="password_toggle"
                                app:startIconDrawable="@android:drawable/ic_lock_lock"
                                app:startIconTint="#98A6BA">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/passwordEdit"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:autofillHints="password"
                                    android:importantForAutofill="yes"
                                    android:inputType="textPassword"
                                    android:maxLines="1"
                                    android:textColor="#344158"
                                    android:textColorHint="#97A4B7" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/useSavedCredentialButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="44dp"
                                android:text="@string/login_use_saved_credential"
                                android:textAllCaps="false"
                                android:textColor="#245EE5"
                                app:cornerRadius="16dp"
                                app:icon="@android:drawable/ic_lock_idle_lock"
                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                app:iconTint="#245EE5"
                                app:strokeColor="#C9D7F7" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/rememberSessionCheck"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/login_remember_session" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:layout_marginTop="16dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/loginButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="@string/login_button"
                                    android:textAllCaps="false"
                                    android:textStyle="bold"
                                    app:backgroundTint="#245EE5"
                                    app:cornerRadius="18dp" />

                                <ProgressBar
                                    android:id="@+id/loginProgress"
                                    style="?android:attr/progressBarStyleSmall"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginStart="22dp"
                                    android:indeterminateTint="#FFFFFF"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/forgotPasswordButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="12dp"
                                android:gravity="center"
                                android:text="@string/login_forgot_password"
                                android:textColor="#245EE5"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/debugStressButton"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="6dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="40dp"
                                android:text="@string/debug_stress_button"
                                android:textAllCaps="false"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/registerContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/register_title"
                                android:textColor="#44546B"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/registerHelpButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/register_help_link"
                                android:textColor="#245EE5"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/registerEmailButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="@string/register_mode_email"
                                android:textAllCaps="false"
                                android:textStyle="bold"
                                app:cornerRadius="18dp"
                                app:strokeColor="#D6DEEA" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/registerInviteButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/register_mode_invite"
                                android:textAllCaps="false"
                                android:textStyle="bold"
                                app:cornerRadius="18dp"
                                app:strokeColor="#D6DEEA" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/registerOrganizationButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/register_mode_org"
                                android:textAllCaps="false"
                                android:textStyle="bold"
                                app:cornerRadius="18dp"
                                app:strokeColor="#D6DEEA" />

                            <TextView
                                android:id="@+id/switchToLoginButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="12dp"
                                android:text="@string/register_switch_login"
                                android:textColor="#245EE5"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/versionText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textColor="#B0BAC8"
                                android:textSize="11sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/loadingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC13395E"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:indeterminateTint="#FFFFFF" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/login_loading_restore"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/blockPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/blockTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/block_title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/blockReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/block_default_reason"
            android:textColor="#E0E0E0"
            android:textSize="14sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/retry" />
    </LinearLayout>

</FrameLayout>
